{
  "permissions": {
    "allow": [
      "Bash",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push origin:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow:*)",
      "Bash(rm -rf:*)",
      "WebFetch"
    ]
  }
}
